PORT="3000"

# Database
DATABASE_URL="mongodb+srv://user:password@cluster0.mongodb.net/carriva?retryWrites=true&w=majority"

# Redis Cache
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# AI Provider Configuration
# Set to 'mock', 'anthropic', 'openai', 'google', or 'huggingface'
AI_PROVIDER="mock"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-32-character-long-secure-random-secret"
BETTER_AUTH_URL="http://localhost:3000"  # Must match PORT above

# AI Models (Optional, defaults set in ai/service.ts)
# AI_MODEL="gpt-4o"
GOOGLE_AI_MODEL="gemini-1.5-flash"
OPENAI_AI_MODEL="gpt-4o"
ANTHROPIC_AI_MODEL="claude-3-5-sonnet-20241022"
HUGGINGFACE_AI_MODEL="Qwen/Qwen3-8B:nscale"

# API Keys (Only the selected provider's key is required)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
HUGGINGFACE_API_KEY=""
